{
  "name": "YT-DLP Auto Downloader",
  "version": "1.1",
  "manifest_version": 3,
  "permissions": [
    "activeTab",
    "cookies",
    "nativeMessaging",
    "notifications",
    "storage"
  ],
  "icons": {
    "128": "icon128.png"
  },
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "YT-DLP Downloader Settings"
  }
}